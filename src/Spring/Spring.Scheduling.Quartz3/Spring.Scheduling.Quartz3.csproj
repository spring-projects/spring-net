<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;$(TargetFullFrameworkVersion);$(TargetModernFrameworkVersion)</TargetFrameworks>
    <Description>Spring.NET Integration with the Quartz Scheduling Library 3.x. Maintenance-only: use Spring.Scheduling.Quartz4 for Quartz.NET 4.x.</Description>
    <PackageTags>$(PackageTags);quartz;scheduling;jobs</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spring.Core\Spring.Core.csproj" />
    <ProjectReference Include="..\Spring.Data\Spring.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" />
  </ItemGroup>
</Project>