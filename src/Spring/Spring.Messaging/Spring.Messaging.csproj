<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;$(TargetFullFrameworkVersion);$(TargetModernFrameworkVersion)</TargetFrameworks>
    <Description>Interfaces and classes that provide MSMQ support in Spring.Net</Description>
    <PackageTags>$(PackageTags);msmq;messaging</PackageTags>
    <!-- Package validation is off for this package. The netstandard2.0 build exposes Experimental.System.Messaging types and the
         net472 build System.Messaging types, so every IMessageQueueOperations and IMessageQueueFactory member differs between
         the two TFMs (CP0002, CP0005, CP0006). That predates 4.0 and cannot be fixed without an API break. Re-enable once
         the two builds share one message type. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' != '.NETFramework' ">
    <PackageReference Include="Experimental.System.Messaging.Signed" />
    <Using Include="Experimental.System.Messaging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spring.Core\Spring.Core.csproj" />
    <ProjectReference Include="..\Spring.Data\Spring.Data.csproj" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFrameworkIdentifier)' == '.NETFramework' ">
    <Reference Include="System.Messaging" />
    <Reference Include="System.Transactions" />
    <Using Include="System.Messaging" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Obsoletions.cs" Link="Obsoletions.cs" />
  </ItemGroup>
</Project>
